# ============================================================
#  BUZZ App — Backend Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================================

# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_DB_PASSWORD@127.0.0.1:3306/bus_tracking"

# MySQL password (used by legacy db.js pool — will be removed)
DB_PASSWORD="YOUR_DB_PASSWORD"

# Server port
PORT=5000

# Admin password (used for admin panel authentication)
# TODO: Replace with proper JWT-based auth
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"
