# ============================================================
#  BUZZ App — .gitignore
#  Covers: Expo / React Native / Node.js / Prisma / Android
# ============================================================

# ─── Dependencies ────────────────────────────────────────────
node_modules/
backend/node_modules/
.pnp/
.pnp.js
.yarn/

# ─── Environment & Secrets ──────────────────────────────────
# NEVER commit real credentials
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ─── Expo ────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
*.hprof

# ─── Metro Bundler ───────────────────────────────────────────
.metro-health-check*

# ─── React Native / Android ─────────────────────────────────
android/app/build/
android/build/
android/.gradle/
android/.idea/
android/local.properties
*.apk
*.aab
*.keystore
!debug.keystore

# ─── React Native / iOS ─────────────────────────────────────
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/

# ─── Kotlin ──────────────────────────────────────────────────
.kotlin/

# ─── Prisma ──────────────────────────────────────────────────
backend/generated/

# ─── Build Outputs ───────────────────────────────────────────
*.tsbuildinfo
build/

# ─── OS Files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.orig.*

# ─── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Certificates ───────────────────────────────────────────
*.pem
*.p8
*.p12
*.jks
*.mobileprovision
*.key

# ─── Debug Logs ──────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
logs/

# ─── Misc ────────────────────────────────────────────────────
app-example/
