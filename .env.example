# ============================================================
#  BUZZ App — Frontend (Expo) Environment Variables
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  All EXPO_PUBLIC_ vars are bundled into the JS — never put
#  truly secret values here. Use the backend for secrets.
# ============================================================

# Backend API URL override (optional — auto-detected in dev)
# Set this for production or when auto-detect doesn't work
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000

# Google Maps API Key (for Android)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Restrict to: Maps SDK for Android + your package name
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
